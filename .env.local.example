# Configuración para ambiente LOCAL (desarrollo local)
# Copiar este archivo a .env.local y ajustar según necesidades

ENVIRONMENT=local

# Code Generator Service Configuration
PORT=5050
HOST=0.0.0.0
DEBUG=True

# CORS settings (use '*' for development, specific origins for production)
CORS_ORIGINS=*

# Docker Configuration
IMAGE_TAG=mls_code_generator:local
CONTAINER_NAME=mls_code_generator

# Docker Network
DOCKER_NETWORK=mls-network
