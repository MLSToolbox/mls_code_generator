# Configuración para ambiente DEVELOPMENT (desarrollo en servidor gessi.cs.upc.edu)
# Copiar este archivo a .env.development y ajustar según necesidades

ENVIRONMENT=development

# Code Generator Service Configuration
PORT=5050
HOST=0.0.0.0
DEBUG=True

# CORS settings (use '*' for development, specific origins for production)
CORS_ORIGINS=*

# Docker Configuration
IMAGE_TAG=mls_code_generator:development
CONTAINER_NAME=mls_code_generator_dev

# Docker Network
DOCKER_NETWORK=mls-network
